DISCORD_TOKEN=your_discord_bot_token
BOT_OWNER_ID=your_discord_user_id
ENVIRONMENT=development
DATABASE_URL=postgresql://user:password@host:5432/database
# Optional: HTTP health-check server port
PORT=8080
# Optional: enables the dashboard's channel/role selectors + username
# search (see web/internal.py). Generate with `python -c "import secrets;
# print(secrets.token_urlsafe(32))"` and put the SAME value in the
# dashboard's DASHBOARD_INTERNAL_KEY — this is NOT the bot token above,
# it's a separate, much more limited secret. Requires PORT to be set.
DASHBOARD_INTERNAL_KEY=

# Production security: use a cryptographically random value of 32+ bytes.
# Example: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The dashboard service must use the exact same value.
